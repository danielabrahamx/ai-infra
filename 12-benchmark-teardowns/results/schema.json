{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark result",
  "type": "object",
  "required": ["schema_version", "harness_version", "timestamp", "validation_only", "target", "workload", "environment", "levels"],
  "properties": {
    "schema_version": {"const": 1},
    "harness_version": {"type": "string"},
    "timestamp": {"type": "string"},
    "label": {"type": "string"},
    "validation_only": {"type": "boolean", "description": "true = harness check only, not a performance claim"},
    "target": {"type": "object", "required": ["base_url", "model"],
               "properties": {"base_url": {"type": "string"}, "model": {"type": "string"},
                              "engine": {"type": "string"}, "quantization": {"type": "string"}}},
    "workload": {"type": "object", "required": ["prompt_words", "max_tokens"]},
    "environment": {"type": "object", "required": ["platform", "python"]},
    "levels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}}
  },
  "$defs": {
    "stat": {"type": "object", "required": ["mean", "p50", "p95", "p99"],
             "properties": {"mean": {"type": ["number", "null"]}, "p50": {"type": ["number", "null"]},
                            "p95": {"type": ["number", "null"]}, "p99": {"type": ["number", "null"]}}},
    "level": {"type": "object",
              "required": ["concurrency", "requests", "errors", "wall_s", "throughput_tok_s", "req_s", "output_tokens", "ttft_ms", "itl_ms", "e2e_ms"],
              "properties": {"concurrency": {"type": "integer", "minimum": 1}, "requests": {"type": "integer"},
                             "errors": {"type": "integer"}, "wall_s": {"type": "number"},
                             "throughput_tok_s": {"type": "number"}, "req_s": {"type": "number"},
                             "output_tokens": {"type": "integer"},
                             "ttft_ms": {"$ref": "#/$defs/stat"}, "itl_ms": {"$ref": "#/$defs/stat"}, "e2e_ms": {"$ref": "#/$defs/stat"}}}
  }
}
